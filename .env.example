# Copy to .env and fill in. Build and dev fail if a required value is missing.
# Resend: https://resend.com/api-keys. Verify the sending domain before going live.
RESEND_API_KEY=
# Where contact form messages go.
CONTACT_TO_EMAIL=owner@example.com
# Must be on a domain verified in Resend, e.g. "Example Co <website@example.com>".
CONTACT_FROM_EMAIL=Website <onboarding@resend.dev>
