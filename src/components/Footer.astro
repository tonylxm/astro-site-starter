---
import { business } from "../business";

// Same name, address and phone as the JSON-LD and the Google Business Profile.
const { name, email, phone, address, areaServed } = business;
const addressLine = address
  ? [
      address.streetAddress,
      address.addressLocality,
      address.addressRegion,
      address.postalCode,
    ]
      .filter(Boolean)
      .join(", ")
  : undefined;
---

<footer class="border-t border-stone-200 text-sm text-stone-600">
  <div class="mx-auto grid max-w-3xl gap-2 px-4 py-6">
    <address class="grid gap-1 not-italic">
      <span class="font-medium text-stone-900">{name}</span>
      {addressLine && <span>{addressLine}</span>}
      {phone && (
        <a href={`tel:${phone.replace(/[^\d+]/g, "")}`} class="underline">
          {phone}
        </a>
      )}
      <a href={`mailto:${email}`} class="underline">
        {email}
      </a>
    </address>
    {areaServed && areaServed.length > 0 && (
      <p>Serving {new Intl.ListFormat("en").format(areaServed)}</p>
    )}
    <p>{`© ${new Date().getFullYear()} ${name}`}</p>
  </div>
</footer>
