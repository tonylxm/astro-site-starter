---
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <h1 class="text-4xl font-semibold tracking-tight text-balance sm:text-5xl">
    Websites that bring in work
  </h1>
  <p class="mt-4 max-w-prose text-lg text-pretty text-stone-700">
    Replace this with the client's pitch: who they help, with what, and why
    them. Keep the first screen to one clear message and one call to action.
  </p>
  <a
    href="/contact"
    class="mt-8 inline-block rounded-md bg-stone-900 px-5 py-3 font-medium text-white hover:bg-stone-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-stone-900"
  >
    Get in touch
  </a>
</Layout>
