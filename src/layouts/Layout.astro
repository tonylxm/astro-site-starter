---
import "../styles/global.css";
import { SITE_ENV } from "astro:env/server";
import { business } from "../business";
import Footer from "../components/Footer.astro";
import JsonLd from "../components/JsonLd.astro";
import { businessJsonLd } from "../lib/json-ld";

interface Props {
  /** Page name. Omit on the home page to use the default title. */
  title?: string;
  description?: string;
  noindex?: boolean;
}

const {
  title,
  description = business.description,
  noindex = false,
} = Astro.props;
const fullTitle = title ? `${title} | ${business.name}` : business.defaultTitle;
// build.format "file" puts ".html" in prerendered pathnames; canonicals must match the sitemap's clean URLs.
const canonical = new URL(
  Astro.url.pathname.replace(/(\/index)?\.html$/, ""),
  Astro.site,
);
const ogImage = new URL("/og.png", Astro.site);
const indexable = SITE_ENV === "production" && !noindex;

const nav = [
  { href: "/", label: "Home" },
  { href: "/services", label: "Services" },
  { href: "/contact", label: "Contact" },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {!indexable && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={business.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <JsonLd data={businessJsonLd(Astro.site!)} />
  </head>
  <body class="flex min-h-dvh flex-col bg-stone-50 text-stone-900 antialiased">
    <header class="border-b border-stone-200">
      <div class="mx-auto flex max-w-3xl items-center justify-between gap-4 px-4 py-4">
        <a href="/" class="font-semibold tracking-tight">
          {business.name}
        </a>
        <nav aria-label="Main">
          <ul class="flex gap-4 text-sm">
            {nav.map(({ href, label }) => (
              <li>
                <a
                  href={href}
                  class="underline-offset-4 hover:underline aria-[current=page]:font-medium aria-[current=page]:underline"
                  aria-current={
                    Astro.url.pathname === href ? "page" : undefined
                  }
                >
                  {label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </header>
    <main class="mx-auto w-full max-w-3xl flex-1 px-4 py-12">
      <slot />
    </main>
    <Footer />
  </body>
</html>
